import requests
from bs4 import BeautifulSoup
from urllib.parse import urlparse

def extract_external_links(target_url):
    try:
        # Send an HTTP GET request to the page
        headers = {'User-Agent': 'EducationalBot/1.0'}
        response = requests.get(target_url, headers=headers, timeout=10)
        
        # Verify the request was successful
        if response.status_code == 200:
            soup = BeautifulSoup(response.text, 'html.parser')
            base_domain = urlparse(target_url).netloc
            external_links = set()

            # Find all hyperlinks on the page
            for link in soup.find_all('a', href=True):
                href = link['href']
                parsed_href = urlparse(href)
                
                # Check if the link points to an external domain
                if parsed_href.netloc and parsed_href.netloc != base_domain:
                    external_links.add(href)
            
            return external_links
    except Exception as e:
        print(f"Error analyzing URL: {e}")
        return set()

