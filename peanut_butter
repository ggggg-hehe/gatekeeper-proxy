// 2. DOM Elements
const searchInput = document.getElementById('searchInput');
const resultsList = document.getElementById('resultsList');

// 3. Search Event Listener
searchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    
    // Clear previous results
    resultsList.innerHTML = '';

    // If search bar is empty, hide the dropdown list and exit
    if (query === '') {
        resultsList.style.display = 'none';
        return;
    }

    // Filter index matches based on Title, Description, or Keywords
    const matchedItems = siteIndex.filter(item => {
        return item.title.toLowerCase().includes(query) || 
               item.description.toLowerCase().includes(query) ||
               item.keywords.some(keyword => keyword.toLowerCase().includes(query));
    });

    // Display Results
    resultsList.style.display = 'block';

    if (matchedItems.length === 0) {
        resultsList.innerHTML = `<li class="no-results">No results found for "${e.target.value}"</li>`;
    } else {
        matchedItems.forEach(item => {
            const li = document.createElement('li');
            li.innerHTML = `
                <a href="${item.url}">
                    ${item.title}
                    <span>${item.description}</span>
                </a>
            `;
            resultsList.appendChild(li);
        });
    }
});

// Close dropdown if user clicks outside of the search box
document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target) && !resultsList.contains(e.target)) {
        resultsList.style.display = 'none';
    }
});
